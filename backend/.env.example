# ==============================================================================
# AuraCare: Alexa+ Voice Caregiving & Remote Family Bridge - Backend Config
# Build, Ship, Shape: Amazon Developer Hackathon 2026
# ==============================================================================

# AWS Bedrock Converse API Configuration
# Supported Models:
# - us.amazon.nova-pro-v1:0
# - us.anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# Server & Network Configuration
HOST=0.0.0.0
PORT=8000
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Hackathon Demo & Fallback Configuration
# When DEMO_MODE=true or AWS credentials are omitted, the agent seamlessly
# operates via the Deterministic Clinical Intent & Multi-Tool Orchestrator.
DEMO_MODE=true
APP_ENV=development
LOG_LEVEL=INFO
